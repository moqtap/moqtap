+/// PATCH: a server's answer to the CONNECT request that opened a session.
+///
+/// The client sends its request, the server answers with a `:status` and
+/// whatever fields it chose, and until this type existed that answer was parsed
+/// and then dropped. It carries the server's half of every negotiation that
+/// happens in the CONNECT exchange — most usefully `WT-Protocol`, the
+/// application protocol the server selected out of the client's
+/// `WT-Available-Protocols` offer, which has no other channel to arrive on.
+#[derive(Clone, Debug)]
+pub struct ConnectResponse {
+    status: u16,
+    headers: HashMap<String, String>,
+}
+
+impl ConnectResponse {
+    pub(crate) fn new(status: u16, headers: HashMap<String, String>) -> Self {
+        Self { status, headers }
+    }
+
+    /// The `:status` of the response.
+    pub fn status(&self) -> u16 {
+        self.status
+    }
+
+    /// Every field of the response, `:status` included, as received.
+    pub fn headers(&self) -> &HashMap<String, String> {
+        &self.headers
+    }
+
+    /// One field, matched without regard to case.
+    ///
+    /// HTTP/3 requires lower-case field names on the wire, so a conformant peer
+    /// needs no folding here — but a field that arrives mis-cased is still the
+    /// field the peer meant, and reading it is closer to correct than reporting
+    /// it absent.
+    pub fn get(&self, key: &str) -> Option<&str> {
+        self.headers
+            .iter()
+            .find(|(k, _)| k.eq_ignore_ascii_case(key))
+            .map(|(_, v)| v.as_str())
+    }
+
+    pub(crate) fn into_headers(self) -> HashMap<String, String> {
+        self.headers
+    }
+}
+
